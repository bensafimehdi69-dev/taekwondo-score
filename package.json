{
  "name": "taekwondo-score-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "analyze": "node scripts/analyze.mjs",
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "brackets": "node scripts/brackets.mjs",
    "admin": "node --env-file-if-exists=.env scripts/set-admin.mjs",
    "dev": "node scripts/prepare-assets.mjs && vite",
    "build": "node scripts/prepare-assets.mjs && vite build"
  },
  "dependencies": {
    "pdfjs-dist": "5.7.284",
    "pdfjs-ios": "npm:pdfjs-dist@3.11.174",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "firebase-admin": "14.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
